				},
				"inputs": [
					{
						"referenceName": "csvFilesSource",
						"type": "DatasetReference",
						"parameters": {
							"container": "source",
							"folder": "CsvFiles",
							"file": "Fact_Sales_1.csv"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "csvFilesDestination",
						"type": "DatasetReference",
						"parameters": {
							"container": "destination",
							"folder": "CsvFiles",
							"file": "Fact_Sales_1.csv"
						}
					}
				]
			},
			{
				"name": "CopyDataHttpsToDest",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "CopyDataSrcToDest",
						"dependencyConditions": [
