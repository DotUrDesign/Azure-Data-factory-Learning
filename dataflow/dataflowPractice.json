{
	"name": "dataflowPractice",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sourceDataJson",
						"type": "DatasetReference"
					},
					"name": "sourceData"
				}
			],
			"sinks": [],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          cancellation_reason_id as integer,",
				"          cancellation_reason as string,",
				"          city_id as integer,",
				"          city as string,",
				"          state as string,",
				"          region as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> sourceData"
			]
		}
	}
}