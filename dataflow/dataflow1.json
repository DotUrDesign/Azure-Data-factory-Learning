{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dataflow_src",
						"type": "DatasetReference"
					},
					"name": "sourceCsvFiles"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sinkDataFlow",
						"type": "DatasetReference"
					},
					"name": "sinkData"
				}
			],
			"transformations": [
				{
					"name": "selectCols"
				},
				{
					"name": "filterRecords"
				},
				{
					"name": "splitPayment"
				},
				{
					"name": "derivedColumn",
					"description": "update the null values to N/A in case of Amex payment records "
				},
				{
					"name": "aggregate"
				},
				{
					"name": "alterRow"
				}
			],
			"scriptLines": [
				"source(output(",
				"          transaction_id as short,",
				"          transactional_date as timestamp,",
				"          product_id as string,",
				"          customer_id as short,",
				"          payment as string,",
				"          credit_card as long,",
				"          loyalty_card as boolean,",
				"          cost as double,",
				"          quantity as short,",
				"          price as double,",
				"          {_c10} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceCsvFiles",
				"sourceCsvFiles select(mapColumn(",
				"          transaction_id,",
				"          transactional_date,",
				"          product_id,",
				"          customer_id,",
				"          payment,",
				"          loyalty_card,",
				"          cost,",
				"          quantity",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectCols",
				"selectCols filter(customer_id != 12) ~> filterRecords",
				"filterRecords split(payment == 'visa',",
				"     payment == 'mastercard',",
				"     disjoint: false) ~> splitPayment@(visa, mastercard, amex)",
				"splitPayment@amex derive(payment = coalesce(payment, 'N/A')) ~> derivedColumn",
				"splitPayment@visa aggregate(groupBy(customer_id),",
				"     product_id = max(product_id)) ~> aggregate",
				"aggregate alterRow(insertIf(1 == 1)) ~> alterRow",
				"alterRow sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkData"
			]
		}
	}
}